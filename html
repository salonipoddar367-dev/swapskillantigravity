       Modal: Post a Swap (Create Listing)
       ========================================================================= -->
  <div id="postSwapModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="postModalTitle">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="postModalTitle" class="modal-title">Post Your Swap Listing</h3>
        <button id="closePostModalBtn" class="modal-close-btn" aria-label="Close modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <form id="postSwapForm">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="postName">Your Full Name *</label>
            <input type="text" id="postName" class="form-input" placeholder="e.g. Alex Morgan" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="postTitle">Your Professional Title / Role *</label>
            <input type="text" id="postTitle" class="form-input" placeholder="e.g. Data Analyst & Python Enthusiast" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="postCategory">Primary Category *</label>
            <select id="postCategory" class="form-select" required>
              <option value="tech">Tech & Code</option>
              <option value="design">Design & Creative</option>
              <option value="languages">Languages</option>
              <option value="business">Business & Growth</option>
              <option value="music">Music & Audio</option>
              <option value="wellness">Wellness & Lifestyle</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Skills You Teach (Type & press Enter or comma) *</label>
            <div id="teachTagBox" class="tag-input-container">
              <input type="text" id="teachTagInput" class="tag-input-field" placeholder="Type skill and press Enter..." />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Skills You Want to Learn (Type & press Enter or comma) *</label>
            <div id="learnTagBox" class="tag-input-container">
              <input type="text" id="learnTagInput" class="tag-input-field" placeholder="Type skill and press Enter..." />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="postBio">Short Bio & Mentoring Approach *</label>
            <textarea id="postBio" class="form-textarea" rows="3" placeholder="Briefly describe your experience and teaching style..." required></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="postAvailability">Availability & Timezone *</label>
            <input type="text" id="postAvailability" class="form-input" placeholder="e.g. Weekends (UTC+1) • Virtual" required />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="cancelPostBtn" class="btn-secondary">Cancel</button>
          <button type="submit" class="btn-primary">Publish Swap</button>
        </div>
      </form>
    </div>
  </div>

  <!-- =========================================================================
       Drawer: My Swaps / Activity Panel
       ========================================================================= -->
  <div id="mySwapsDrawer" class="drawer-backdrop" role="dialog" aria-modal="true">
    <div class="drawer-panel">
      <div class="drawer-header">
        <h3 class="drawer-title">My Swap Dashboard</h3>
        <button id="closeDrawerBtn" class="modal-close-btn" aria-label="Close drawer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="drawer-content">
        <!-- Karma Card -->
        <div class="karma-score-card">
          <div class="karma-info">
            <h4>Karma / Swap Credit</h4>
            <div class="karma-score">100%</div>
            <div class="karma-ratio">1 Hour Taught = 1 Hour Learned</div>
          </div>
          <div style="font-size: 2.25rem;">✨</div>
        </div>

        <div>
          <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--slate-900);">
            Active & Proposed Swaps (<span id="drawerCountNum">0</span>)
          </h4>
          <div id="drawerProposalsList" style="display: flex; flex-direction: column; gap: 0.85rem;">
            <!-- Rendered by app.js -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container"></div>

  <!-- Scripts -->
  <script src="js/data.js"></script>
  <script src="js/app.js"></script>
</body>
</html>

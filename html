  <div id="proposeModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="proposeModalTitle">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="proposeModalTitle" class="modal-title">Propose a Skill Swap</h3>
        <button id="closeProposeModalBtn" class="modal-close-btn" aria-label="Close modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <form id="proposeForm">
        <div class="modal-body">
          <div id="targetPartnerPreview" class="propose-target-preview">
            <!-- Populated dynamically -->
          </div>

          <div class="form-group">
            <label class="form-label" for="proposeOfferedSkill">What skill will you teach them in exchange? *</label>
            <input type="text" id="proposeOfferedSkill" class="form-input" placeholder="e.g. Conversational French, Vue.js, Guitar" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="proposeHours">Proposed Frequency / Commitment *</label>
            <select id="proposeHours" class="form-select" required>
              <option value="1 hour / week">1 hour / week (Recommended)</option>
              <option value="2 hours / week">2 hours / week (Intensive)</option>
              <option value="1 session bi-weekly">1 session bi-weekly</option>
              <option value="Single 90-min consultation">Single 90-min consultation</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="proposeMessage">Personal Introduction & Pitch *</label>
            <textarea id="proposeMessage" class="form-textarea" rows="4" placeholder="Introduce yourself, your experience level, and how you envision dividing your sessions..." required></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="cancelProposeBtn" class="btn-secondary">Cancel</button>
          <button type="submit" class="btn-primary">Send Swap Proposal</button>
        </div>
      </form>
    </div>
  </div>


/* ==========================================================================
   SkillSwap - Professional Design System & Stylesheet
   ========================================================================== */

:root {
  /* Brand Color Palette */
  --primary: #4f46e5;
  --primary-hover: #4338ca;
  --primary-light: #eef2ff;
  --primary-rgb: 79, 70, 229;

  --secondary: #0ea5e9;
  --secondary-hover: #0284c7;

  --accent-teach: #10b981;
  --accent-teach-light: #ecfdf5;
  --accent-teach-border: #a7f3d0;
  --accent-teach-text: #065f46;

  --accent-learn: #6366f1;
  --accent-learn-light: #f5f3ff;
  --accent-learn-border: #c7d2fe;
  --accent-learn-text: #3730a3;

  --amber: #f59e0b;
  --amber-light: #fffbeb;
  --amber-text: #92400e;

  /* Neutral Spectrum */
  --slate-950: #020617;
  --slate-900: #0f172a;
  --slate-800: #1e293b;
  --slate-700: #334155;
  --slate-600: #475569;
  --slate-500: #64748b;
  --slate-400: #94a3b8;
  --slate-300: #cbd5e1;
  --slate-200: #e2e8f0;
  --slate-100: #f1f5f9;
  --slate-50: #f8fafc;
  --white: #ffffff;

  /* Surfaces & Backgrounds */
  --bg-body: #f8fafc;
  --bg-card: #ffffff;
  --border-color: #e2e8f0;
  --border-hover: #cbd5e1;

  /* Typography */
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  /* Elevations */
  --shadow-xs: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
  --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.08), 0 1px 2px -1px rgba(15, 23, 42, 0.08);
  --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04);
  --shadow-xl: 0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
  --shadow-glow: 0 0 25px -5px rgba(79, 70, 229, 0.25);

  /* Transitions */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-slow: 0.4s cubic-bezier(0.16, 1, 0.3, 1);

  /* Radii */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-pill: 9999px;
}

/* ==========================================================================
   Base & Reset
   ========================================================================== */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-body);
  color: var(--slate-800);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

img {
  max-width: 100%;
  display: block;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* ==========================================================================
   Header & Navigation
   ========================================================================== */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  transition: all var(--transition-fast);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74px;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-weight: 800;
  font-size: 1.35rem;
  color: var(--slate-900);
  letter-spacing: -0.02em;
}

.logo-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--primary) 0%, #818cf8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--white);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
}

.logo-badge {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 700;
  vertical-align: middle;
  margin-left: 4px;
}

.nav-menu {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 2rem;
}

.nav-link {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--slate-600);
  transition: color var(--transition-fast);
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.nav-link:hover {
  color: var(--primary);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

/* Badge count button */
.btn-my-swaps {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--slate-700);
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-my-swaps:hover {
  background: var(--slate-50);
  border-color: var(--slate-300);
  color: var(--slate-900);
}

.swap-badge-count {
  background: var(--primary);
  color: var(--white);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: var(--radius-pill);
}

/* Primary Button */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.65rem 1.35rem;
  font-size: 0.925rem;
  font-weight: 600;
  color: var(--white);
  background: var(--primary);
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.28);
  transition: all var(--transition-fast);
}

.btn-primary:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(79, 70, 229, 0.35);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.65rem 1.25rem;
  font-size: 0.925rem;
  font-weight: 600;
  color: var(--slate-700);
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-secondary:hover {
  border-color: var(--slate-400);
  background: var(--slate-50);
  color: var(--slate-900);
}

/* Mobile Toggle */
.mobile-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--slate-700);
  padding: 6px;
}

/* ==========================================================================
   Hero Section
   ========================================================================== */

.hero-section {
  position: relative;
  padding: 5rem 0 4rem;
  overflow: hidden;
  background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.09) 0%, rgba(248, 250, 252, 0) 70%);
  border-bottom: 1px solid var(--border-color);
}

.hero-content {
  text-align: center;
  max-width: 840px;
  margin: 0 auto;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 1rem;
  background: var(--white);
  border: 1px solid rgba(79, 70, 229, 0.2);
  border-radius: var(--radius-pill);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow-sm);
}

.hero-pill .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-teach);
  box-shadow: 0 0 8px var(--accent-teach);
}

.hero-title {
  font-size: 3.25rem;
  line-height: 1.15;
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.03em;
  margin-bottom: 1.25rem;
}

.hero-title span.gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, #06b6d4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 1.2rem;
  color: var(--slate-600);
  margin-bottom: 2.5rem;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

/* Search Box Container */
.hero-search-card {
  background: var(--white);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-xl);
  border-radius: var(--radius-lg);
  padding: 0.75rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  max-width: 880px;
  margin: 0 auto 2rem;
  position: relative;
}

.search-input-group {
  flex: 1 1 240px;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.5rem 0.85rem;
  background: var(--slate-50);
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  transition: all var(--transition-fast);
}

.search-input-group:focus-within {
  background: var(--white);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

.search-label-icon {
  color: var(--slate-400);
}

.search-input-group.learn .search-label-icon {
  color: var(--accent-learn);
}

.search-input-group.teach .search-label-icon {
  color: var(--accent-teach);
}

.search-input-box {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.search-mini-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--slate-500);
}

.search-input-field {
  border: none;
  background: transparent;
  font-weight: 600;
  color: var(--slate-800);
  outline: none;
  padding: 2px 0;
  font-size: 0.95rem;
}

.search-input-field::placeholder {
  color: var(--slate-400);
  font-weight: 400;
}

.search-divider-icon {
  color: var(--slate-300);
  font-size: 1.1rem;
}

.hero-search-btn {
  padding: 0.85rem 1.8rem;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: var(--radius-md);
}

/* Quick tags */
.hero-quick-tags {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: var(--slate-500);
  margin-bottom: 3.5rem;
}

.quick-tag-chip {
  background: var(--white);
  border: 1px solid var(--border-color);
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-pill);
  font-weight: 500;
  color: var(--slate-600);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.quick-tag-chip:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-light);
}

/* Hero Stats */
.hero-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 1.5rem 2rem;
  box-shadow: var(--shadow-sm);
  max-width: 980px;
  margin: 0 auto;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-number {
  font-size: 1.85rem;
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.02em;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--slate-500);
  font-weight: 500;
}

/* ==========================================================================
   How It Works Section
   ========================================================================== */

.section {
  padding: 5rem 0;
}

.section-header {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 3.5rem;
}

.section-tag {
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 0.5rem;
}

.section-title {
  font-size: 2.25rem;
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.02em;
  line-height: 1.25;
  margin-bottom: 0.75rem;
}

.section-desc {
  font-size: 1.05rem;
  color: var(--slate-600);
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  position: relative;
}

.step-card {
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 2.25rem 1.75rem;
  position: relative;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.step-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.step-number {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--slate-100);
  line-height: 1;
}

.step-icon-wrapper {
  width: 54px;
  height: 54px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.5rem;
}

.step-icon-wrapper.teach {
  background: var(--accent-teach-light);
  color: var(--accent-teach);
}

.step-icon-wrapper.match {
  background: var(--primary-light);
  color: var(--primary);
}

.step-icon-wrapper.grow {
  background: #fdf2f8;
  color: #db2777;
}

.step-heading {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--slate-900);
  margin-bottom: 0.75rem;
}

.step-detail {
  font-size: 0.95rem;
  color: var(--slate-600);
  line-height: 1.6;
}

/* ==========================================================================
   Match Calculator Widget
   ========================================================================== */

.match-widget-section {
  background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
  color: var(--white);
  padding: 3.5rem 0;
  border-radius: var(--radius-xl);
  margin: 2rem auto;
  box-shadow: var(--shadow-xl);
}

.match-widget-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 920px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.match-widget-title {
  font-size: 1.85rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.match-widget-subtitle {
  color: var(--slate-300);
  margin-bottom: 2rem;
  font-size: 1rem;
}

.match-form {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.match-select-box {
  flex: 1 1 260px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-md);
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
  text-align: left;
}

.match-select-box label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--slate-300);
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.match-select-box select {
  background: transparent;
  border: none;
  color: var(--white);
  font-weight: 600;
  outline: none;
  cursor: pointer;
}

.match-select-box select option {
  background: var(--slate-900);
  color: var(--white);
}

.match-btn {
  padding: 0.85rem 2rem;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: var(--radius-md);
  background: var(--accent-teach);
  color: var(--white);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.match-btn:hover {
  background: #059669;
  transform: translateY(-1px);
}

/* ==========================================================================
   Explore Swaps Marketplace
   ========================================================================== */

.marketplace-section {
  padding: 4rem 0 6rem;
}

.category-filter-bar {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  overflow-x: auto;
  padding-bottom: 0.75rem;
  margin-bottom: 2rem;
  scrollbar-width: thin;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.15rem;
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-pill);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--slate-600);
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--transition-fast);
}

.category-tab:hover {
  border-color: var(--slate-400);
  color: var(--slate-900);
  background: var(--slate-50);
}

.category-tab.active {
  background: var(--slate-900);
  color: var(--white);
  border-color: var(--slate-900);
}

/* Filter controls bar */
.feed-controls-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2rem;
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1rem 1.5rem;
}

.feed-count-summary {
  font-weight: 600;
  color: var(--slate-600);
  font-size: 0.95rem;
}

.feed-count-summary strong {
  color: var(--slate-900);
}

.feed-sort-wrapper {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  color: var(--slate-500);
}

.feed-sort-select {
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background: var(--white);
  color: var(--slate-700);
  font-weight: 600;
  outline: none;
  cursor: pointer;
}

/* Swaps Grid */
.swaps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 1.75rem;
}

/* Swap Card */
.swap-card {
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  position: relative;
}

.swap-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: rgba(79, 70, 229, 0.3);
}

.swap-card-header {
  padding: 1.5rem 1.5rem 1rem;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.user-profile-meta {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.user-avatar-wrapper {
  position: relative;
  width: 52px;
  height: 52px;
  flex-shrink: 0;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--white);
  box-shadow: var(--shadow-xs);
}

.user-status-online {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 12px;
  height: 12px;
  background: var(--accent-teach);
  border: 2px solid var(--white);
  border-radius: 50%;
}

.user-name-role {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--slate-900);
  line-height: 1.25;
}

.user-title {
  font-size: 0.8rem;
  color: var(--slate-500);
  line-height: 1.35;
  margin-top: 2px;
}

.user-rating-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: var(--amber-light);
  color: var(--amber-text);
  padding: 0.25rem 0.55rem;
  border-radius: var(--radius-pill);
  font-size: 0.8rem;
  font-weight: 700;
  border: 1px solid rgba(245, 158, 11, 0.2);
}

.user-rating-pill svg {
  color: var(--amber);
  fill: var(--amber);
}

.swap-card-bio {
  padding: 0 1.5rem 1rem;
  font-size: 0.9rem;
  color: var(--slate-600);
  line-height: 1.5;
}

/* Exchange Skills Section in Card */
.swap-exchange-box {
  padding: 1.25rem 1.5rem;
  background: var(--slate-50);
  border-top: 1px solid var(--slate-100);
  border-bottom: 1px solid var(--slate-100);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  flex-grow: 1;
}

.exchange-row {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.exchange-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exchange-tag-title {
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.exchange-tag-title.teach {
  color: var(--accent-teach-text);
}

.exchange-tag-title.learn {
  color: var(--accent-learn-text);
}

.skills-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.skill-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-md);
  font-size: 0.8rem;
  font-weight: 600;
  border: 1px solid transparent;
}

.skill-chip.teach {
  background: var(--accent-teach-light);
  color: var(--accent-teach-text);
  border-color: var(--accent-teach-border);
}

.skill-chip.learn {
  background: var(--accent-learn-light);
  color: var(--accent-learn-text);
  border-color: var(--accent-learn-border);
}

.skill-level-badge {
  font-size: 0.65rem;
  font-weight: 700;
  opacity: 0.85;
  text-transform: uppercase;
  background: rgba(0, 0, 0, 0.05);
  padding: 1px 4px;
  border-radius: 4px;
}

.exchange-divider-strip {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--slate-400);
  font-size: 0.75rem;
}

.exchange-divider-strip::before,
.exchange-divider-strip::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--slate-200);
}

/* Card footer */
.swap-card-footer {
  padding: 1.15rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.card-location-meta {
  font-size: 0.75rem;
  color: var(--slate-500);
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.btn-propose-swap {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--slate-900);
  color: var(--white);
  border: none;
  padding: 0.55rem 1.15rem;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: var(--radius-pill);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-propose-swap:hover {
  background: var(--primary);
  transform: translateY(-1px);
}

/* Empty search state */
.empty-state {
  text-align: center;
  padding: 4rem 1.5rem;
  grid-column: 1 / -1;
  background: var(--white);
  border: 1px dashed var(--slate-300);
  border-radius: var(--radius-xl);
}

.empty-state-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1rem;
  color: var(--slate-400);
}

.empty-state-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--slate-800);
  margin-bottom: 0.5rem;
}

.empty-state-desc {
  font-size: 0.95rem;
  color: var(--slate-500);
  margin-bottom: 1.5rem;
}

/* ==========================================================================
   Success Stories / Testimonials
   ========================================================================== */

.stories-section {
  background: var(--white);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
}

.stories-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.story-card {
  background: var(--slate-50);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.story-swap-pair {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
}

.pair-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--white);
  box-shadow: var(--shadow-sm);
}

.pair-swap-icon {
  color: var(--primary);
  font-size: 1.1rem;
}

.story-quote {
  font-size: 0.95rem;
  color: var(--slate-700);
  font-style: italic;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.story-author {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--slate-900);
}

.story-outcome {
  font-size: 0.78rem;
  color: var(--accent-teach);
  font-weight: 600;
}

/* ==========================================================================
   FAQ Section Accordion
   ========================================================================== */

.faq-container {
  max-width: 800px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.faq-item {
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all var(--transition-fast);
}

.faq-question {
  width: 100%;
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: none;
  border: none;
  text-align: left;
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--slate-900);
  cursor: pointer;
}

.faq-icon {
  transition: transform var(--transition-fast);
  color: var(--slate-400);
}

.faq-item.open .faq-icon {
  transform: rotate(180deg);
  color: var(--primary);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
  padding: 0 1.5rem;
  color: var(--slate-600);
  font-size: 0.95rem;
  line-height: 1.6;
}

.faq-item.open .faq-answer {
  max-height: 500px;
  padding-bottom: 1.25rem;
  transition: max-height 0.3s ease-in-out;
}

/* ==========================================================================
   CTA Banner
   ========================================================================== */

.cta-banner {
  padding: 4rem 0;
}

.cta-card {
  background: linear-gradient(135deg, var(--primary) 0%, #3730a3 100%);
  border-radius: var(--radius-xl);
  padding: 4rem 2rem;
  text-align: center;
  color: var(--white);
  box-shadow: var(--shadow-xl);
  position: relative;
  overflow: hidden;
}

.cta-card h2 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.cta-card p {
  font-size: 1.15rem;
  color: #c7d2fe;
  max-width: 600px;
  margin: 0 auto 2rem;
}

.btn-white {
  background: var(--white);
  color: var(--primary);
  font-weight: 700;
  padding: 0.85rem 2rem;
  border-radius: var(--radius-pill);
  border: none;
  cursor: pointer;
  font-size: 1rem;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  transition: all var(--transition-fast);
}

.btn-white:hover {
  background: var(--slate-100);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
}

/* ==========================================================================
   Footer
   ========================================================================== */

.site-footer {
  background: var(--slate-950);
  color: var(--slate-400);
  padding: 4rem 0 2rem;
  margin-top: auto;
  border-top: 1px solid var(--slate-800);
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr repeat(3, 1fr);
  gap: 3rem;
  margin-bottom: 3.5rem;
}

.footer-brand p {
  margin-top: 1rem;
  font-size: 0.9rem;
  max-width: 320px;
  line-height: 1.6;
}

.footer-col h4 {
  color: var(--white);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1.25rem;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  font-size: 0.9rem;
}

.footer-links a:hover {
  color: var(--white);
}

.footer-bottom {
  padding-top: 2rem;
  border-top: 1px solid var(--slate-800);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
  flex-wrap: wrap;
  gap: 1rem;
}

/* ==========================================================================
   Modals & Slide-over Drawer
   ========================================================================== */

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;
}

.modal-backdrop.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: var(--white);
  border-radius: var(--radius-xl);
  width: 100%;
  max-width: 580px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-xl);
  transform: scale(0.96) translateY(10px);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

.modal-backdrop.active .modal-content {
  transform: scale(1) translateY(0);
}

.modal-header {
  padding: 1.5rem 1.75rem;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--slate-900);
}

.modal-close-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--slate-400);
  padding: 4px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color var(--transition-fast);
}

.modal-close-btn:hover {
  color: var(--slate-800);
}

.modal-body {
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--slate-700);
}

.form-input, .form-select, .form-textarea {
  padding: 0.75rem 1rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  color: var(--slate-800);
  background: var(--white);
  transition: all var(--transition-fast);
  outline: none;
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
}

/* Tag input styling */
.tag-input-container {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  padding: 0.5rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--white);
  min-height: 48px;
  align-items: center;
}

.tag-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  font-weight: 600;
}

.tag-badge.teach {
  background: var(--accent-teach-light);
  color: var(--accent-teach-text);
}

.tag-badge.learn {
  background: var(--accent-learn-light);
  color: var(--accent-learn-text);
}

.tag-remove-btn {
  background: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  color: inherit;
  opacity: 0.6;
}

.tag-remove-btn:hover {
  opacity: 1;
}

.tag-input-field {
  border: none;
  outline: none;
  flex: 1 1 120px;
  font-size: 0.9rem;
  padding: 4px;
}

.modal-footer {
  padding: 1.25rem 1.75rem;
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  background: var(--slate-50);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

/* Partner Preview in Propose Modal */
.propose-target-preview {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--slate-50);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1rem;
}

.propose-target-preview img {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}

/* Slide-over Drawer for My Swaps */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.drawer-backdrop.active {
  opacity: 1;
  visibility: visible;
}

.drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 460px;
  height: 100vh;
  background: var(--white);
  z-index: 1150;
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

.drawer-backdrop.active .drawer-panel {
  transform: translateX(0);
}

.drawer-header {
  padding: 1.5rem;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.drawer-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--slate-900);
}

.drawer-content {
  padding: 1.5rem;
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.karma-score-card {
  background: linear-gradient(135deg, var(--slate-900) 0%, #1e293b 100%);
  color: var(--white);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.karma-info h4 {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--slate-400);
  margin-bottom: 0.25rem;
}

.karma-score {
  font-size: 2rem;
  font-weight: 800;
  color: var(--accent-teach);
}

.karma-ratio {
  font-size: 0.8rem;
  color: var(--slate-300);
}

.proposal-item {
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1rem;
  background: var(--slate-50);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.proposal-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.proposal-status-badge {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
  color: var(--primary);
}

.proposal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 0.5rem;
}

.btn-cancel-prop {
  background: none;
  border: none;
  font-size: 0.78rem;
  color: #ef4444;
  cursor: pointer;
  font-weight: 600;
}

.btn-cancel-prop:hover {
  text-decoration: underline;
}

/* ==========================================================================
   Toast Notification
   ========================================================================== */

.toast-container {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  background: var(--slate-900);
  color: var(--white);
  padding: 1rem 1.25rem;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  display: flex;
  align-items: center;
  gap: 0.85rem;
  min-width: 320px;
  max-width: 420px;
  animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  border-left: 4px solid var(--accent-teach);
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.toast.toast-out {
  animation: toastOut 0.25s ease forwards;
}

@keyframes toastOut {
  to {
    opacity: 0;
    transform: translateY(10px) scale(0.95);
  }
}

.toast-icon {
  color: var(--accent-teach);
  flex-shrink: 0;
}

.toast-body {
  flex: 1;
}

.toast-title {
  font-size: 0.9rem;
  font-weight: 700;
}

.toast-msg {
  font-size: 0.8rem;
  color: var(--slate-300);
}

/* ==========================================================================
   Responsive Breakpoints
   ========================================================================== */

@media (max-width: 1024px) {
  .hero-title {
    font-size: 2.75rem;
  }
  .hero-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .steps-grid, .stories-grid {
    grid-template-columns: 1fr;
  }
  .footer-top {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .nav-menu {
    display: none;
  }
  .mobile-toggle {
    display: block;
  }
  .hero-title {
    font-size: 2.15rem;
  }
  .hero-subtitle {
    font-size: 1rem;
  }
  .hero-search-card {
    flex-direction: column;
    align-items: stretch;
  }
  .search-divider-icon {
    display: none;
  }
  .hero-search-btn {
    width: 100%;
  }
  .swaps-grid {
    grid-template-columns: 1fr;
  }
  .footer-top {
    grid-template-columns: 1fr;
  }
}
